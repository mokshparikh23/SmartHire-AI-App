{
  "name": "smarthire-desktop",
  "version": "1.0.4",
  "description": "Interviewer copilot — listens with the candidate's consent and suggests what to ask next",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Smart Hire AI",
  "homepage": "https://web-moksh-8946s-projects.vercel.app",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development ELECTRON_RUN_AS_NODE= electron .",
    "build": "vite build",
    "icon": "cross-env ELECTRON_RUN_AS_NODE= electron scripts/make-icon.cjs",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "build:all": "npm run build && electron-builder --config electron-builder.config.cjs --mac --win",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.8",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "dotenv": "^16.0.0",
    "electron-store": "^8.2.0",
    "openai": "^4.0.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "unpdf": "^1.4.0",
    "zustand": "^4.5.7"
  }
}
