# Anthropic API key, used by src/services/claude.js for both answering and
# follow-up calls. This is the only AI key the app actually reads — the name is
# VITE_CLAUDE_API_KEY, not VITE_ANTHROPIC_API_KEY.
VITE_CLAUDE_API_KEY=sk-ant-your-key-here

# There is no OpenAI, Whisper or Groq integration yet: src/services/openai.js,
# whisper.js and aiRouter.js are empty files that nothing imports. An OpenAI key
# has nothing to plug into until those are written. The Groq key in the settings
# store is entered through the app's UI, not from here.

# Backend that issues and validates license keys.
# Defaults to the deployed app; point it at a local web build during development.
# Use 127.0.0.1, not localhost: Electron's main process runs Node, which
# resolves localhost to ::1 and will not fall back to IPv4.
WEB_URL=http://127.0.0.1:3000
