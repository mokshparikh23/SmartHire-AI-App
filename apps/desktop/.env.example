# OpenAI is the only AI provider. One key covers both jobs: chat completions
# for the answers and Whisper for transcribing the interview audio.
#
# This is a fallback for development. The key you enter on the Settings screen
# takes priority, so most users never need this file — see getApiKey() in
# src/services/openai.js for the full order.
VITE_OPENAI_API_KEY=sk-your-key-here

# Backend that issues and validates license keys.
# Defaults to the deployed app; point it at a local web build during development.
# Use 127.0.0.1, not localhost: Electron's main process runs Node, which
# resolves localhost to ::1 and will not fall back to IPv4.
WEB_URL=http://127.0.0.1:3000
