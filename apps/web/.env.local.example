# Copy to .env.local and fill in from your Supabase project:
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Service role key — bypasses RLS. Used by the admin pages and by
# /api/license/validate, which the desktop app calls. Server-side only;
# never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# ─────────────────────────────────────────────────────────────── payments
#
# TWO GATEWAYS, chosen by the currency the request's geo headers resolve to —
# see lib/gateway.js. Neither is required to run the app: licences can still be
# issued from /admin/licenses without any payment configured at all.
#
#     INR  -> Razorpay   UPI, net banking, cards, wallets
#     else -> Stripe     international cards
#
# RAZORPAY 2026-08-30: this block used to say "Stripe is optional. lib/stripe.js
# is not imported anywhere and the `stripe` package is not in package.json".
# Both halves stopped being true when checkout was built — stripe is a
# dependency and app/api/checkout imports it — and the three PRICE_ID variables
# below were never read by anything. Checkout sends inline price_data from
# lib/pricing.js precisely so there are no price objects to keep in sync.
#
# # STRIPE_SECRET_KEY=
# # STRIPE_MONTHLY_PRICE_ID=
# # STRIPE_YEARLY_PRICE_ID=
# # STRIPE_LIFETIME_PRICE_ID=

# Stripe — the non-INR half. The webhook secret is the signing secret shown when
# you add the endpoint (…/api/stripe/webhook), not the API key.
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay — the INR half. Until KEY_ID and KEY_SECRET are both set, INR
# checkout falls back to Stripe rather than failing, so this can be switched on
# without a deploy. The /compare table reads the same flag and shows UPI as a
# caveat until it is live.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
#
# The secret you typed when creating the webhook (…/api/razorpay/webhook), NOT
# the key secret above. Events to tick: payment_link.paid, subscription.activated,
# subscription.charged, subscription.halted, subscription.pending,
# subscription.cancelled, subscription.completed, subscription.expired.
# RAZORPAY_WEBHOOK_SECRET=
#
# Subscription plans, created once in the Razorpay dashboard. Their amounts MUST
# match SUBSCRIPTION_TIERS in lib/pricing.js — checkout reads each plan back and
# refuses to charge anyone if they disagree, rather than letting the two drift.
# RAZORPAY_PLAN_WEEKLY=plan_...
# RAZORPAY_PLAN_MONTHLY=plan_...
# RAZORPAY_PLAN_YEARLY=plan_...

# AI provider for the /api/ai routes. The desktop app never receives either of
# these — it sends its licence key and this server makes the call on its behalf.
# Server-side only; never prefix them with NEXT_PUBLIC_.
#
# SET ONE OF THE TWO. OpenAI wins if both are set; Gemini is the fallback.
# The check is on the VALUE, not the name, so a key left blank (OPENAI_API_KEY=)
# counts as absent and falls through to Gemini rather than failing every call.
OPENAI_API_KEY=sk-your-key-here

# Reached through Gemini's OpenAI-compatible endpoint for chat, answers and
# screenshots, so those need no separate code path. Transcription is the one
# exception — that compatibility layer has no transcription endpoint, so
# /api/ai/transcribe calls Gemini's native surface instead.
GEMINI_API_KEY=

# RESUME-UPLOAD 2026-08-30
# Company logo autocomplete on the Interviews page. Optional — without it the
# Company field is a plain text input and nothing else changes.
#
# NEXT_PUBLIC_ IS CORRECT HERE. This is the only public-prefixed credential-
# shaped value in the repo, so it looks like the mistake the comment above warns
# about, and it is not: Brandfetch's search endpoint takes a CLIENT ID, not a
# secret, and their guidelines say to call it from the browser. That is not a
# preference — the rate limit is 200 requests per 5 minutes PER IP, so proxying
# it through our server would put every user in one bucket and throttle the whole
# product. Their brand data also must not be cached, which removes the other
# reason to proxy. Do not "fix" this by dropping the prefix.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
