# Copy to .env.local and fill in from your Supabase project:
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Service role key — bypasses RLS. Used by the admin pages and by
# /api/license/validate, which the desktop app calls. Server-side only;
# never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# Stripe is optional. lib/stripe.js is not imported anywhere and the `stripe`
# package is not in package.json, so the app runs fine without these. Licenses
# can be issued from /admin/licenses without any payment.
# STRIPE_SECRET_KEY=
# STRIPE_MONTHLY_PRICE_ID=
# STRIPE_YEARLY_PRICE_ID=
# STRIPE_LIFETIME_PRICE_ID=

# OpenAI key for the /api/ai routes. The desktop app never receives this — it
# sends its licence key and this server makes the OpenAI call on its behalf.
# Server-side only; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-key-here
