{
  "name": "smarthire-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Interview Assistant — Electron desktop app and its Next.js licensing backend",
  "workspaces": [
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n web,desktop -c cyan,magenta \"npm run dev:web\" \"npm run dev:desktop\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "build:web": "npm run build --workspace apps/web",
    "build:mac": "npm run build:mac --workspace apps/desktop",
    "build:win": "npm run build:win --workspace apps/desktop",
    "build:all": "npm run build:all --workspace apps/desktop"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
